# Langflow 로컬 실행 설정 예시 (docs/20). 이 파일을 langflow.env로 복사해 값을 채운다.
# langflow.env에는 비밀번호가 들어가므로 Git·채팅·보고서에 넣지 않는다(.gitignore 대상).
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7860
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# 전역 변수 암호화 키. 줄을 지운 채 두면 Langflow가 만든다.
# 직접 넣으려면 Fernet 형식(32바이트를 url-safe base64로 인코딩)이어야 한다. 형식이 틀리면 전역 변수 저장이 실패한다.
# LANGFLOW_SECRET_KEY=
# 로컬 jeju-mcp(127.0.0.1:8788)만 허용한다. 사설망 전체나 CIDR 범위를 열지 않는다.
LANGFLOW_SSRF_ALLOWED_HOSTS=127.0.0.1
# 시스템이나 환경 변수에 프록시가 설정돼 있으면 Langflow가 Ollama·MCP로 보내는 loopback 요청까지 프록시로 간다. 이를 막는다.
NO_PROXY=127.0.0.1,localhost
DO_NOT_TRACK=true
